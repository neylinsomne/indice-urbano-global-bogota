# Secrets — never commit these
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.cloudflare
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/

# Gitleaks audit reports (no se publican)
.gitleaks-report.json
.gitleaks-report.csv

# Cloudflare tunnel credentials (json con token, NUNCA al repo)
cloudflared/
*-credentials.json
config.yml.local

# Stitch design exports (binarios, no aportan al repo)
stitch_extract/
stitch_inmu_urban_data_saas.zip

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/

# Node
node_modules/
dist/
build/
.vite/

# Docker
.docker/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Data dumps (mantener solo samples)
data/raw/
data/processed/
data/full_dump.sql
*.dump

# Scrapers — caches y dumps de páginas (pueden contener API keys públicas de terceros)
services/scraping/**/page_content.txt
services/scraping/**/*.html
services/scraping/**/cache/
services/scraping/**/.scrapy/
services/scraping/**/finca/cookies/
services/scraping/**/finca/proxies-rotativas/
*.jl
*.jsonl

# Notebooks: limpiar outputs antes de commit
# (mantener .ipynb pero sin outputs gigantes; usar nbstripout opcional)

# Logs
logs/
*.log

# Temp
tmp/
temp/

# Chrome extensions (.crx) — binarios de terceros, no se distribuyen
*.crx

# Test residues en spiders
services/scraping/**/resultados.json
services/scraping/**/prueba.py
