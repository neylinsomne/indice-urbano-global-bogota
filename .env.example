# ===========================================
# Inmu — Plantilla de variables de entorno
# ===========================================
# Copiar como .env y completar con valores reales.
# NUNCA commitear el archivo .env real.

# ====== MongoDB (datos crudos de scraping) ======
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/
MONGO_DB_RAW=Finca_inmuebles
MONGO_DB_PRO=procesado
MONGO_COLE_RAW_FINCA=indi_finca
MONGO_COLE_RAW_HABI=habi_newera
MONGO_COLE_PRO=inmuebles

# ====== PostgreSQL (analítica + vectorial) ======
PG_HOST=localhost
PG_PORT=5434
PG_DB=postgres
PG_USER=postgres
PG_PASSWORD=changeme

# ====== Seguridad ======
ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=GENERAR_CON_SECRETS_TOKEN_HEX_32
PIPELINE_SECRET=GENERAR_CON_SECRETS_TOKEN_HEX_32
REDIS_PASSWORD=changeme

# ====== Asistente RAG (Gemini) ======
# Obtener en https://aistudio.google.com
GOOGLE_API_KEY=

# ====== Email SMTP (verificación OTP) ======
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ====== WhatsApp (Meta Cloud API, opcional) ======
META_WA_TOKEN=
META_WA_PHONE_ID=
META_WA_VERIFY_TOKEN=
META_WA_APP_SECRET=
API_BASE_URL=http://localhost:8000

# ====== Cloudflare Tunnel (despliegue público) ======
CLOUDFLARE_TUNNEL_TOKEN=

# ====== Grafana (monitoreo, opcional) ======
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# ====== Scraping (proxies, opcional) ======
# Si tienes un proxy disponible, formato: http://IP:PORT
# Dejar vacío para scraping directo.
SCRAPER_PROXIES=
