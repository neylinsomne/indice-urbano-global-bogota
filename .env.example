# ============================================================================
# Índice Urbano Global de Bogotá — Plantilla de variables de entorno
# ============================================================================
# Copia este archivo como `.env` y completa los valores reales.
# NUNCA hagas commit del `.env` con valores reales (está en .gitignore).
#
# Generar secretos con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================================


# ── PostgreSQL (datos espaciales + IUG) ─────────────────────────────────────
# Superusuario, usado por Flyway para migraciones.
PG_HOST=localhost
PG_PORT=5434
PG_DB=postgres
PG_USER=postgres
PG_PASSWORD=changeme_pg_password

# Usuario "app" con permisos limitados al schema iug (creado por V119).
# Lo usa la API en runtime — más seguro que el superuser.
APP_PG_USER=app_user
APP_PG_PASSWORD=changeme_app_password


# ── Redis (cache + memoria conversacional del asistente) ────────────────────
REDIS_PASSWORD=changeme_redis_pwd


# ── Seguridad ───────────────────────────────────────────────────────────────
# Entorno: "development" / "staging" / "production".
# En production se desactivan /docs y /redoc.
ENV=development

# CORS — orígenes permitidos, separados por coma.
# En production deja solo dominios reales.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT — secreto para firmar tokens de auth (bcrypt-12 + JWT HS256).
JWT_SECRET=GENERAR_CON_secrets.token_hex(32)

# Secreto compartido para que los scrapers autentiquen sus uploads al API.
PIPELINE_SECRET=GENERAR_CON_secrets.token_hex(32)


# ── Asistente RAG (Gemini) ──────────────────────────────────────────────────
# Obtener gratis en https://aistudio.google.com (Gemini Flash tier free).
# Sin esta clave, los endpoints /llm/* responderán 503.
GOOGLE_API_KEY=

# Alternativa: OpenAI (no usado actualmente, pero compatible).
OPENAI_API_KEY=


# ── MongoDB (datos crudos del scraping) ─────────────────────────────────────
# Atlas free tier funciona perfectamente para reproducir el proyecto.
# Formato: mongodb+srv://USER:PASS@cluster.mongodb.net/
MONGO_URI=
MONGO_DB_RAW=Finca_inmuebles
MONGO_DB_PRO=procesado
MONGO_COLE_RAW_FINCA=indi_finca
MONGO_COLE_RAW_HABI=habi_newera
MONGO_COLE_PRO=inmuebles


# ── Email SMTP (verificación OTP de registro) — opcional ────────────────────
# Sin esto la verificación por email queda deshabilitada.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_NOTIFY_EMAIL=


# ── Scraping (proxies opcionales) ───────────────────────────────────────────
# Si tienes un proxy rotativo, formato: http://USER:PASS@IP:PORT
# Múltiples proxies separados por coma. Vacío = scraping directo.
SCRAPER_PROXIES=
SCRAPE_MODE=matrix
SCRAPE_TXS=venta,arriendo
SCRAPE_TIPOS=apartamentos,casas
SCRAPE_SECTORES=bogota


# ── Grafana (monitoreo, opcional) ───────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme_grafana


# ============================================================================
# DEPLOYMENT (opcional — no se usa en local)
# ============================================================================

# ── Cloudflare Tunnel ───────────────────────────────────────────────────────
# Permite exponer el API a internet sin abrir puertos en el router.
# Crea un túnel en https://one.dash.cloudflare.com → Networks → Tunnels.
# Copia el token (string largo que empieza con `eyJh...`) aquí:
CLOUDFLARE_TUNNEL_TOKEN=
